# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Cloud's
# secrets manager. Never commit the real file.
OPENAI_API_KEY = "sk-..."
GOOGLE_CLIENT_ID = "....apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET = "..."
REDIRECT_URI = "http://localhost:8501"

# Optional. Restrict access to specific people rather than everyone at
# datarails.com. Commas, spaces or newlines all work. Remove or leave empty to
# allow any @datarails.com account.
ALLOWED_EMAILS = "omer.y@datarails.com, someone@datarails.com"
